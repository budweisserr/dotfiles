# macos/Brewfile — only what this setup itself needs.
#
# This is deliberately NOT a port of your Arch package list. It is the three
# apps aerospace.toml launches, plus the font kitty.conf asks for. Your own
# tools belong in your own Brewfile, or in an "extras" block you add below.
#
# Install:  brew bundle --file=macos/Brewfile

# --- the window manager the keymap drives ------------------------------
cask "nikitabobko/tap/aerospace"

# --- the three apps aerospace.toml launches ----------------------------
# alt-enter
cask "kitty"
# alt-r
cask "raycast"
# alt-p. Drop this and the alt-p binding together if you prefer macOS's own
# cmd-shift-4 screenshot.
cask "flameshot"

# --- fonts -------------------------------------------------------------
# kitty.conf sets `font_family Fira Mono`. The plain cask supplies exactly
# that family; the nerd variant covers the icons in btop and powerline
# prompts. Use one font for everything by switching the kitty line to
# `FiraMono Nerd Font` and deleting the first of these two.
cask "font-fira-mono"
cask "font-fira-mono-nerd-font"

# --- your own tools ----------------------------------------------------
# `brew bundle` merges any file named Brewfile, so the neatest option is a
# separate macos/Brewfile.local that you keep out of the repo:
#
#   brew "tmux"
#   brew "neovim"
#   cask "visual-studio-code"
