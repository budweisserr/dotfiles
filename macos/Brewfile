# macos/Brewfile — `brew bundle --file=macos/Brewfile`
#
# Ports the Arch toolchain (`pacman -Qe`) to macOS equivalents. Sections
# labelled "extras" are additions rather than ports — trim them freely.
#
# Every name below was checked against the Homebrew API, so `brew bundle`
# should resolve cleanly. If one still fails, `brew search <name>`.

# --- window management / desktop ---------------------------------------
cask "nikitabobko/tap/aerospace"    # tiling WM — awesome replacement, no SIP off
cask "raycast"                      # rofi replacement: run prompt + clipboard + window
cask "alt-tab"                      # the alt-tab switcher widget from awesome
cask "jordanbaird-ice"              # menu bar manager (awesome topbar widgets)
cask "stats"                        # menu bar CPU/RAM/battery/temp
cask "flameshot"                    # Print-key screenshot habit from awesome
cask "mos"                          # smooth scrolling for external mice

# --- terminal ----------------------------------------------------------
cask "kitty"                        # same terminal as Linux, same config
