# macos/Brewfile — only what this setup itself needs.
#
# This is deliberately NOT a port of your Arch package list. It is the two
# apps aerospace.toml launches, plus the font kitty.conf asks for. Your own
# tools belong in a Brewfile.local, as described at the bottom of this file.
#
# Install:  brew bundle --file=macos/Brewfile

# --- the window manager the keymap drives ------------------------------
cask "nikitabobko/tap/aerospace"

# --- the two apps aerospace.toml launches ------------------------------
# alt-enter
cask "kitty"
# alt-r
cask "raycast"
# alt-p uses macOS's own screencapture, so it needs no cask at all.

# --- fonts -------------------------------------------------------------
# kitty.conf sets `font_family Fira Mono`. The plain cask supplies exactly
# that family; the nerd variant covers the icons in btop and powerline
# prompts. Use one font for everything by switching the kitty line to
# `FiraMono Nerd Font` and deleting the first of these two.
cask "font-fira-mono"
cask "font-fira-mono-nerd-font"

# --- your own tools ----------------------------------------------------
# `brew bundle` merges a file named Brewfile.local that sits next to this
# one, which is the neatest place for your own tools. It is gitignored, so
# it stays out of the repo:
#
#   brew "tmux"
#   brew "neovim"
#   cask "visual-studio-code"
